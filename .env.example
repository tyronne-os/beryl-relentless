# Beryl Relentless — required environment variables
# Copy to .env and fill in values. NEVER commit .env to git.

# Hugging Face
HF_TOKEN=hf_...
HUGGING_FACE_HUB_TOKEN=hf_...

# NVIDIA
NVIDIA_API_KEY=nvapi-...
NGC_API_KEY=nvapi-...
NGC_ENTERPRISE_KEY=nvapi-...

# TypeSafe / JEV
TYPESAFE_API_KEY=...
JEV_API_KEY=...

# GitHub
GITHUB_TOKEN=ghp_...
GH_TOKEN=ghp_...

# Google Cloud
GCP_SA_KEY_JSON={"type":"service_account",...}
GCP_ZONE=us-east1-c

# Kaggle
KAGGLE_USERNAME=...
KAGGLE_KEY=...

# Pipeline feature flags
CRANE_JEV=true
CRANE_JEV_MODEL=jev-latest
CRANE_STAGE=L1
